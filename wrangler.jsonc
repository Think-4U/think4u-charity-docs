{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "think4u-charity-docs",
  "compatibility_date": "2026-10-23",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
